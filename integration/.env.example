# ─────────────────────────────────────────────────────────────────────────────
# ryuu-proxy — Integration Test Environment
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp integration/.env.example integration/.env
# 2. Fill in the values below (see integration/README.md for setup steps)
# 3. Run:  pnpm run test:integration
# ─────────────────────────────────────────────────────────────────────────────

# Domo instance hostname — no protocol, no trailing slash.
# Must match the instance you authenticated with via `domo login`.
DOMO_INSTANCE=your-instance.domo.com

# UUID of the test dataset (sales.csv uploaded to Domo).
# Domo → Data Center → your dataset → copy the UUID from the URL.
DOMO_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Proxy ID — the subdomain UUID from a published card's embed URL.
#   Card embed URL format: https://{PROXY_ID}.domoapps.prod3.domo.com
# Open a card's overflow menu → Share → Embed → copy the UUID subdomain.
DOMO_PROXY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Card / design instance ID (visible in the Domo URL when viewing the card).
# Example: https://your-instance.domo.com/page/123/kpis/details/456
#   The last numeric segment is often used, but the UUID in the embed URL is
#   what matters for DOMO_PROXY_ID above. This can be left empty if proxyId
#   is set — it is only needed to create a temporary instance.
DOMO_ASSET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Dataset alias as defined in your published card's manifest.
# The proxy maps requests like /sql/v1/{alias} using this name.
# Defaults to "sales" if omitted — set this if your card uses a different alias.
DOMO_DATASET_ALIAS=sales

# Local port for the sales dataset integration test server (default: 4321).
INTEGRATION_PORT=4321

# Local port for the spool-iq integration test server (default: 4322).
# The spool-iq tests read ~/dev/spool-iq/.tmp/manifest.json automatically.
SPOOLIQ_INTEGRATION_PORT=4322
